      vertex_project: "YOUR_GCP_PROJECT_ID"
      vertex_location: "global"

  # Gemini 3.5 Flash
  - model_name: gemini-3.5-flash
    litellm_params:
      model: vertex_ai/gemini-3.5-flash
      vertex_project: "YOUR_GCP_PROJECT_ID"
      vertex_location: "global"

# =====================================================================
# LiteLLM Proxy Settings & Database Connection
# =====================================================================
litellm_settings:
  drop_params: true
  
general_settings: 
  master_key: sk-1111
  database_url: "postgresql://postgres:pg1234@localhost:5432/litellm"
