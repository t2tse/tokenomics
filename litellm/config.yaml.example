# =====================================================================
# LiteLLM Configuration File for Tokenomics Test Harness
# =====================================================================

model_list:
  # -------------------------------------------------------------------
  # Anthropic Claude Models on Agent Platform (Google Cloud)
  # -------------------------------------------------------------------

  # Claude Opus (latest)
  - model_name: claude-opus
    litellm_params:
      model: vertex_ai/claude-opus-5
      vertex_project: "YOUR_GCP_PROJECT_ID"
      vertex_location: "global"

  # Claude Opus 5
  - model_name: claude-opus-5
    litellm_params:
      model: vertex_ai/claude-opus-5
      vertex_project: "YOUR_GCP_PROJECT_ID"
      vertex_location: "global"

  # Claude Opus 4.8
