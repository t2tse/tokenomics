# ==============================================================================
# LiteLLM Proxy & Tokenomics Environment Configuration
# ==============================================================================

# LiteLLM Proxy connection settings
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-1111

# Settling delay (in ms) before querying LiteLLM spend metrics after test runs
TOKENOMICS_DELAY=10000

# Automated evaluation settings
TOKENOMICS_EVALUATION=true
TOKENOMICS_EVAL_MODEL=gemini-pro

# Default agent & model fallbacks (used when not specified in test-plan.json)
TOKENOMICS_AGENT=claude
TOKENOMICS_MODEL=claude-sonnet
TOKENOMICS_MODEL_PLANNING=claude-sonnet
TOKENOMICS_MODEL_EXECUTION=gemini-flash
TOKENOMICS_CONFIG=test-plan.json
